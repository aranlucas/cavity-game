{
  "name": "cavity-rush",
  "private": true,
  "workspaces": [
    "client",
    "worker",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w worker\" \"npm run dev -w client\"",
    "build": "npm run build -w client && npm run check -w worker && wrangler deploy --dry-run",
    "deploy": "npm run build -w client && wrangler deploy",
    "lint": "oxlint client worker shared",
    "lint:fix": "oxlint client worker shared --fix",
    "format": "oxfmt client worker shared",
    "format:check": "oxfmt --check client worker shared",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.127.1"
  }
}
