{
  "name": "cavity-rush",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client && cf deploy --dry-run",
    "deploy": "npm run build -w client && cf deploy",
    "lint": "oxlint client",
    "lint:fix": "oxlint client --fix",
    "format": "oxfmt client",
    "format:check": "oxfmt --check client",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "cf": "^1.0.0-beta.5",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.143.0"
  }
}
