{
  "name": "cavity-rush",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "dev:direct": "npm run dev:direct -w client",
    "build": "npm run build -w client",
    "deploy": "npm run deploy -w client",
    "lint": "oxlint client tests",
    "lint:fix": "oxlint client tests --fix",
    "format": "oxfmt client",
    "format:check": "oxfmt --check client",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "oxfmt": "^0.72.0",
    "oxlint": "1.87.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
