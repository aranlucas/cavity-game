{
  "name": "cavity-rush",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @cavity-rush/client run dev",
    "build": "pnpm --filter @cavity-rush/client run build",
    "deploy": "pnpm --filter @cavity-rush/client run deploy",
    "lint": "oxlint client test",
    "lint:fix": "oxlint client test --fix",
    "format": "oxfmt client",
    "format:check": "oxfmt --check client",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm run typecheck:tooling"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.3.0",
    "@types/node": "26.6.6",
    "@types/three": "^0.187.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.14.0"
}
