{
  "name": "cavity-rush",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "deploy": "npm run deploy -w client",
    "lint": "oxlint client tests",
    "lint:fix": "oxlint client tests --fix",
    "format": "oxfmt client",
    "format:check": "oxfmt --check client",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.1.3",
    "@aranlucas/oxlint-plugin-anti-slop": "0.1.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
