{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@aranlucas/oxforge/configs/recommended.json"
  ],
  "plugins": [
    "jsx-a11y",
    "react",
    "typescript",
    "unicorn"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2026": true
  },
  "rules": {
    "oxc/no-accumulating-spread": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "**/.cloudflare/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**"
  ]
}
