{
  "extends": ["../.oxlintrc.json", "../node_modules/@aranlucas/oxforge/configs/react.json"],
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "env": {
    "node": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.expo/**",
    "**/.vercel/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.gemini/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.roo/**",
    "**/.windsurf/**"
  ],
  "overrides": [
    {
      "files": ["src/app.tsx", "src/appointment/clinic.tsx", "src/appointment/use-clinic-sound.ts"],
      "rules": {
        "typescript/consistent-return": "off"
      }
    }
  ]
}
