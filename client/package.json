    "three": "^0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "cf": "1.0.0-beta.26",
    "portless": "0.15.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
