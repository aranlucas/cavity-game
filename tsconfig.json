{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": ["oxfmt.config.ts", "vitest.config.mts", "test/**/*.mjs"]
}
